{
	"name": "pageatlas",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview --host",
		"tauri:dev": "cross-env PAGEATLAS_TARGET=desktop tauri dev",
		"tauri:build": "cross-env PAGEATLAS_TARGET=desktop tauri build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"pnpm": {
		"supportedArchitectures": {
			"os": ["current", "win32", "linux"],
			"cpu": ["current", "x64"],
			"libc": ["current", "glibc"]
		}
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tauri-apps/cli": "^2.10.1",
		"@types/node": "^25.5.0",
		"autoprefixer": "^10.4.20",
		"cross-env": "^10.1.0",
		"pdfjs-dist": "^4.10.38",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.0.0",
		"vite": "^6.0.0"
	},
	"dependencies": {
		"@aptabase/web": "^0.4.3",
		"@google/generative-ai": "^0.24.1",
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-opener": "^2",
		"jsonrepair": "^3.13.1",
		"lucide-svelte": "^0.474.0",
		"openai": "^6.15.0",
		"pdf-fontkit": "^1.8.9",
		"pdf-lib": "^1.17.1",
		"roughjs": "^4.6.6",
		"short-unique-id": "^5.2.0",
		"svelte-dnd-action": "^0.9.68",
		"svelte-file-dropzone": "^2.0.9",
		"svelte-i18n": "^4.0.1"
	}
}
