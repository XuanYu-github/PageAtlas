{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PageAtlas",
  "version": "0.1.0",
  "identifier": "com.pageatlas",
  "build": {
    "beforeDevCommand": "cross-env PAGEATLAS_TARGET=desktop pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cross-env PAGEATLAS_TARGET=desktop pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PageAtlas",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": false
    }
  }
}
